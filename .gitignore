# Зависимости
node_modules/
.pnpm-store/

# Сборка
dist/
dist-tauri/
*.local

# Tauri (Этап 4)
src-tauri/target/
src-tauri/permissions/

# Вывод сборки Android — мусор, восстанавливается сборкой. А само дерево
# исходников android-проекта нужно: там манифест с android:banner, ресурсы
# (баннер, mipmap-*) и точки входа. Без этого правка манифеста и баннер не
# защищены ничем: они не выводятся ни из tauri.conf.json, ни из
# src-tauri/icons, а tauri android init перезапишет их шаблоном.
#
# Запись идёт через gen/*, а не gen/: с gen/ git вообще не спускается
# внутрь каталога, и никакое последующее отрицание уже не сработает.
src-tauri/gen/*
!src-tauri/gen/android/
!src-tauri/gen/android/**
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/src/main/jniLibs/

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Кэш инструментов
.vite/
.cache/
*.tsbuildinfo
vite.config.ts.timestamp-*.mjs

# Редакторы и ОС
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Рабочие заметки инструмента: память проекта, а не его исходники
.workbuddy-ai/

# Секреты (токены подписи обновлений Tauri и пр.)
.env
.env.*
!.env.example
*.key
